# Control plane database (tenants, API keys, signing keys).
CONTROL_PLANE_DATABASE_URL=postgres://nelcota:nelcota@localhost:5434/nelcota_control
# Server where tenant databases are created; the database name is appended per tenant. Its
# password is required: the Data API's own role password is derived from it.
TENANT_DATABASE_BASE_URL=postgres://nelcota:nelcota@localhost:5434
# 32 random bytes as 64 hex characters. Encrypts tenant secrets at rest.
MASTER_KEY_HEX=
# At least 32 characters. Required in the x-admin-token header for /admin routes.
ADMIN_TOKEN=
# Public URL of this server. OAuth callback: {PUBLIC_BASE_URL}/auth/v1/oauth/callback
PUBLIC_BASE_URL=http://localhost:8080
# smtp:// (STARTTLS optional), smtps:// (implicit TLS); credentials go in the URL.
SMTP_URL=smtp://localhost:1026
EMAIL_FROM="NelcotaCloud <no-reply@nelcota.local>"
# Local development only: Mailpit API, read by the integration tests.
MAILPIT_API_URL=http://localhost:8026
BIND_ADDRESS=127.0.0.1:8080
# Optional. Header with the real client IP set by a trusted proxy (cf-connecting-ip behind
# Cloudflare). Only set it when the server is reachable exclusively through that proxy.
# CLIENT_IP_HEADER=cf-connecting-ip
RUST_LOG=info,server=debug

# Tenant whose users log into the console (create it with POST /admin/v1/tenants).
PLATFORM_TENANT_SLUG=console
# Development only: tenants may point their SMTP settings at local hosts (Mailpit).
TENANT_SMTP_ALLOW_ANY_HOST=true
# Development only: webhook endpoints may use plain http and local hosts.
WEBHOOK_ALLOW_PRIVATE_HOSTS=true

# Optional: direct Postgres connections through PgBouncer (docker compose --profile pooler).
# DATABASE_PUBLIC_HOST=localhost
# DATABASE_PUBLIC_PORT=6544
# DATABASE_PUBLIC_SSL_MODE=require
# 64 hex characters, the same value PgBouncer gets.
# POOLER_AUTH_PASSWORD=

# Optional: private R2 bucket for project files. Set all four values to enable Storage.
# STORAGE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_R2_BUCKET=
# STORAGE_R2_ACCESS_KEY_ID=
# STORAGE_R2_SECRET_ACCESS_KEY=
