{
  "openapi": "3.1.0",
  "info": {
    "title": "NelcotaCloud API",
    "description": "Multitenant Auth: every request names its tenant with an API key.",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "paths": {
    "/admin/v1/tenants": {
      "post": {
        "tags": [
          "platform-admin"
        ],
        "operationId": "create_tenant",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTenantBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Tenant created; its API keys are shown only here",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedTenantResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid slug, name or site URL",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong admin token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Slug already taken",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "admin_token": []
          }
        ]
      }
    },
    "/auth/v1/admin/oauth/{provider}": {
      "put": {
        "tags": [
          "tenant-admin"
        ],
        "summary": "`PUT /admin/oauth/{provider}`: the tenant registers its own OAuth app (secret key only).",
        "operationId": "configure_oauth_provider",
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "description": "`google` or `github`",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProviderCredentialsBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Provider configured with the tenant's own OAuth app"
          },
          "403": {
            "description": "Requires the secret API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Unknown provider",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "api_key": []
          }
        ]
      }
    },
    "/auth/v1/admin/settings": {
      "get": {
        "tags": [
          "tenant-admin"
        ],
        "summary": "`GET /admin/settings` (secret key only).",
        "operationId": "read_tenant_settings",
        "responses": {
          "200": {
            "description": "Current settings",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantSettings"
                }
              }
            }
          },
          "403": {
            "description": "Requires the secret API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "api_key": []
          }
        ]
      },
      "patch": {
        "tags": [
          "tenant-admin"
        ],
        "summary": "`PATCH /admin/settings` (secret key only): changes only the fields that are sent.",
        "operationId": "change_tenant_settings",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TenantSettingsBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Updated settings",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantSettings"
                }
              }
            }
          },
          "400": {
            "description": "Invalid name or site URL",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Requires the secret API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "api_key": []
          }
        ]
      }
    },
    "/auth/v1/jwks": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Public keys of the tenant, so other services can verify access tokens without calling us.\nThe document is serialized once per key set and shared by every response.",
        "operationId": "jwks",
        "responses": {
          "200": {
            "description": "The tenant's public keys (JWKS) to verify access tokens",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "security": [
          {
            "api_key": []
          }
        ]
      }
    },
    "/auth/v1/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "`POST /login`: email and password.",
        "operationId": "log_in",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LogInBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Logged in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionTokens"
                }
              }
            }
          },
          "401": {
            "description": "Invalid email or password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Email not verified yet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "Too many attempts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "api_key": []
          }
        ]
      }
    },
    "/auth/v1/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Always answers 204, even for unknown tokens, so the endpoint cannot be used to probe tokens.",
        "operationId": "log_out",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Session ended (also for unknown tokens)"
          }
        },
        "security": [
          {
            "api_key": []
          }
        ]
      }
    },
    "/auth/v1/oauth/callback": {
      "get": {
        "tags": [
          "oauth"
        ],
        "summary": "`GET /oauth/callback`: the provider sends the browser here.",
        "description": "On success the browser goes back to the app with a short-lived `code` (exchanged at\n`POST /oauth/token` with the app's PKCE verifier), never with tokens in the URL; on\nfailure, with an `error` code.",
        "operationId": "oauth_callback",
        "parameters": [
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "code",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "303": {
            "description": "Redirects back to the app with a one-time `code`, or an `error`"
          },
          "400": {
            "description": "Unknown or expired state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/auth/v1/oauth/token": {
      "post": {
        "tags": [
          "oauth"
        ],
        "summary": "`POST /oauth/token`: trades the one-time code from the OAuth redirect for a session. The\ncode is consumed even when the verifier is wrong, so it cannot be guessed against.",
        "operationId": "exchange_oauth_code",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OAuthCodeBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Logged in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionTokens"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or expired code, or wrong code verifier",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "api_key": []
          }
        ]
      }
    },
    "/auth/v1/oauth/{provider}/authorize": {
      "get": {
        "tags": [
          "oauth"
        ],
        "summary": "`GET /oauth/{provider}/authorize`: redirects the browser to the provider's sign-in page.",
        "operationId": "authorize_oauth",
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "description": "`google` or `github`",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "apikey",
            "in": "query",
            "description": "The publishable key travels in the query: this endpoint is opened by a browser redirect.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "redirect_to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "code_challenge",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "code_challenge_method",
            "in": "query",
            "description": "Only S256 is supported; it may be omitted.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "303": {
            "description": "Redirects the browser to the provider's sign-in page"
          },
          "400": {
            "description": "Invalid redirect, PKCE challenge or provider not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Unknown provider",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "Too many attempts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/auth/v1/recover": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "`POST /recover`: emails a password reset link.",
        "operationId": "recover_password",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "A reset link is sent if the email has an account"
          },
          "429": {
            "description": "Too many emails requested",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "api_key": []
          }
        ]
      }
    },
    "/auth/v1/refresh": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "`POST /refresh`: rotates the refresh token. The presented token is consumed first, so a\nrefused refresh (e.g. email verification now required) also ends that session.",
        "operationId": "refresh_session",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "New tokens; the refresh token sent is no longer valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionTokens"
                }
              }
            }
          },
          "401": {
            "description": "Invalid, expired, reused or revoked refresh token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Email not verified yet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "api_key": []
          }
        ]
      }
    },
    "/auth/v1/reset-password": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "`POST /reset-password`: consuming the link, setting the password and ending every session\nhappen in one transaction, so a failure leaves the link usable and nothing half done.",
        "operationId": "reset_password",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPasswordBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Password changed and every session ended"
          },
          "400": {
            "description": "Invalid or expired token, or weak password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "api_key": []
          }
        ]
      }
    },
    "/auth/v1/signup": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "`POST /signup`.",
        "operationId": "sign_up",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignUpBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Account created and logged in (email verification off)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignUpResponse"
                }
              }
            }
          },
          "202": {
            "description": "Check the inbox; same answer for new and existing emails",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignUpResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid email or weak password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Email already registered (email verification off)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "Too many attempts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "api_key": []
          }
        ]
      }
    },
    "/auth/v1/user": {
      "get": {
        "tags": [
          "auth"
        ],
        "operationId": "current_user",
        "responses": {
          "200": {
            "description": "The logged-in user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "api_key": [],
            "bearer": []
          }
        ]
      }
    },
    "/auth/v1/verify-email": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "`POST /verify-email`: consuming the link and marking the email verified are one transaction.",
        "operationId": "verify_email",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OneTimeTokenBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Email verified",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or expired token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "api_key": []
          }
        ]
      }
    },
    "/auth/v1/verify-email/resend": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "`POST /verify-email/resend`: emails a new verification link to an unverified account.",
        "operationId": "resend_verification",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "A link is sent if the email has an unverified account"
          },
          "429": {
            "description": "Too many emails requested",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "api_key": []
          }
        ]
      }
    },
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "operationId": "health",
        "responses": {
          "200": {
            "description": "The API is up",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateTenantBody": {
        "type": "object",
        "required": [
          "slug",
          "name",
          "site_url"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "require_email_verification": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Defaults to true: only verified emails can log in with a password."
          },
          "site_url": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        }
      },
      "CreatedTenantResponse": {
        "type": "object",
        "required": [
          "tenant_id",
          "slug",
          "publishable_key",
          "secret_key"
        ],
        "properties": {
          "publishable_key": {
            "type": "string"
          },
          "secret_key": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "tenant_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "EmailBody": {
        "type": "object",
        "description": "Body of the endpoints that email a link to an address.",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string"
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "LogInBody": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "OAuthCodeBody": {
        "type": "object",
        "required": [
          "code",
          "code_verifier"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "code_verifier": {
            "type": "string"
          }
        }
      },
      "OneTimeTokenBody": {
        "type": "object",
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "string"
          }
        }
      },
      "ProviderCredentialsBody": {
        "type": "object",
        "required": [
          "client_id",
          "client_secret"
        ],
        "properties": {
          "client_id": {
            "type": "string"
          },
          "client_secret": {
            "type": "string"
          }
        }
      },
      "RefreshTokenBody": {
        "type": "object",
        "required": [
          "refresh_token"
        ],
        "properties": {
          "refresh_token": {
            "type": "string"
          }
        }
      },
      "ResetPasswordBody": {
        "type": "object",
        "required": [
          "token",
          "password"
        ],
        "properties": {
          "password": {
            "type": "string"
          },
          "token": {
            "type": "string"
          }
        }
      },
      "SessionTokens": {
        "type": "object",
        "required": [
          "access_token",
          "token_type",
          "expires_in",
          "refresh_token",
          "user"
        ],
        "properties": {
          "access_token": {
            "type": "string"
          },
          "expires_in": {
            "type": "integer",
            "format": "int64"
          },
          "refresh_token": {
            "type": "string"
          },
          "token_type": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "SignUpBody": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "description": "Format is checked by `EmailAddress::parse`, after trimming and lowercasing."
          },
          "password": {
            "type": "string"
          }
        }
      },
      "SignUpResponse": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/SessionTokens"
          },
          {
            "type": "object",
            "required": [
              "verification_required"
            ],
            "properties": {
              "verification_required": {
                "type": "boolean"
              }
            }
          }
        ],
        "description": "A session when the tenant lets unverified users in; otherwise only a note to check the inbox."
      },
      "TenantSettings": {
        "type": "object",
        "description": "Settings a tenant manages itself with its secret key.",
        "required": [
          "name",
          "site_url",
          "require_email_verification"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "require_email_verification": {
            "type": "boolean"
          },
          "site_url": {
            "type": "string"
          }
        }
      },
      "TenantSettingsBody": {
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "require_email_verification": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "site_url": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "email",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "email": {
            "type": "string"
          },
          "email_verified_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    },
    "securitySchemes": {
      "admin_token": {
        "type": "apiKey",
        "in": "header",
        "name": "x-admin-token"
      },
      "api_key": {
        "type": "apiKey",
        "in": "header",
        "name": "apikey",
        "description": "The tenant's publishable key (browser apps) or secret key (servers, admin routes)"
      },
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "tags": [
    {
      "name": "auth",
      "description": "Signup, login and sessions of a tenant's users"
    },
    {
      "name": "oauth",
      "description": "Login with Google or GitHub through the tenant's own OAuth app"
    },
    {
      "name": "tenant-admin",
      "description": "A tenant's own configuration (secret API key)"
    },
    {
      "name": "platform-admin",
      "description": "Operations of the platform operator (admin token)"
    },
    {
      "name": "system",
      "description": "Health of the API"
    }
  ]
}
