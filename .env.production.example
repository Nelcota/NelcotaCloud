# Copy to .env.production on the VPS and fill every value. Never commit the copy.
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# DNS A/AAAA records of both domains must point to the VPS; Caddy then gets the certificates.
API_DOMAIN=api.example.com
CONSOLE_DOMAIN=console.example.com
# Let's Encrypt account email (expiry notices).
ACME_EMAIL=

# Hex only (it goes inside database URLs): openssl rand -hex 32
POSTGRES_PASSWORD=
# Separate runtime credential for the API pools and webhook worker: openssl rand -hex 32
DATABASE_RUNTIME_PASSWORD=
# 32 random bytes as 64 hex characters: openssl rand -hex 32
MASTER_KEY_HEX=
# At least 32 characters: openssl rand -hex 32
ADMIN_TOKEN=

# Your SMTP provider; credentials go in the URL. smtps:// for implicit TLS (port 465).
SMTP_URL=smtps://user:password@smtp.example.com:465
EMAIL_FROM="NelcotaCloud <no-reply@example.com>"

# Behind Cloudflare's proxy (orange cloud): set SSL/TLS mode to "Full (strict)", use
# cf-connecting-ip, and allow only Cloudflare's addresses (https://www.cloudflare.com/ips/)
# to reach ports 80/443, or clients could fake their IP.
# CLIENT_IP_HEADER=cf-connecting-ip
RUST_LOG=info

# Console accounts are users of this tenant. After the first boot, create it with the admin
# API (docs/deploy.md), put its publishable key below and rebuild the caddy service.
PLATFORM_TENANT_SLUG=console
PLATFORM_PUBLISHABLE_KEY=

# Optional: authenticated Valkey on a private network reachable from the API container.
# CACHE_VALKEY_URL=redis://:password@valkey.internal:6379

# Optional: private R2 bucket for project files, separate from backups.
# STORAGE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_R2_BUCKET=
# STORAGE_R2_ACCESS_KEY_ID=
# STORAGE_R2_SECRET_ACCESS_KEY=

# Backups: daily encrypted dumps to a Cloudflare R2 bucket (create an R2 API token with
# Object Read & Write on that bucket only). Endpoint: https://<account-id>.r2.cloudflarestorage.com
BACKUP_BUCKET=nelcota-backups
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Encrypts the dumps before upload. Keep a copy outside the VPS: without it, backups cannot be
# restored. openssl rand -hex 32
BACKUP_ENCRYPTION_PASSWORD=
# BACKUP_INTERVAL_SECONDS=86400
# BACKUP_RETENTION_DAYS=30
