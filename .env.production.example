# Copy to .env.production on the VPS and fill every value. Never commit the copy.
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# DNS A/AAAA records of both domains must point to the VPS; Caddy then gets the certificates.
API_DOMAIN=api.example.com
CONSOLE_DOMAIN=console.example.com
# Let's Encrypt account email (expiry notices).
ACME_EMAIL=

# Hex only (it goes inside database URLs): openssl rand -hex 32
POSTGRES_PASSWORD=
# A separate 64-character hex secret for ordinary API and worker connections.
POSTGRES_RUNTIME_PASSWORD=

# Optional project cache. Uncomment these three lines together and set a random 64-character
# lowercase hex password (openssl rand -hex 32).
# COMPOSE_PROFILES=cache
# VALKEY_PASSWORD=
# CACHE_VALKEY_URL=redis://:${VALKEY_PASSWORD}@valkey:6379
# Optional: select the PostgreSQL volume after a major upgrade (see docs/deploy.md).
# POSTGRES_DATA_VOLUME=
# 32 random bytes as 64 hex characters: openssl rand -hex 32
MASTER_KEY_HEX=
# At least 32 characters: openssl rand -hex 32
ADMIN_TOKEN=

# Your SMTP provider; credentials go in the URL. smtps:// for implicit TLS (port 465).
SMTP_URL=smtps://user:password@smtp.example.com:465
EMAIL_FROM="NelcotaCloud <no-reply@example.com>"

# Behind Cloudflare's proxy (orange cloud): set SSL/TLS mode to "Full (strict)", use
# cf-connecting-ip, and allow only Cloudflare's addresses (https://www.cloudflare.com/ips/)
# to reach ports 80/443, or clients could fake their IP.
# CLIENT_IP_HEADER=cf-connecting-ip
RUST_LOG=info

# Console accounts are users of this tenant. After the first boot, create it with the admin
# API (docs/deploy.md), put its publishable key below and rebuild the caddy service.
PLATFORM_TENANT_SLUG=console
PLATFORM_PUBLISHABLE_KEY=

# Optional: private R2 bucket for project files, separate from backups.
# STORAGE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_R2_BUCKET=
# STORAGE_R2_ACCESS_KEY_ID=
# STORAGE_R2_SECRET_ACCESS_KEY=
# STORAGE_R2_ADOPT_LEGACY=false
# Read-only R2 token for the backup service, scoped to STORAGE_R2_BUCKET.
# STORAGE_BACKUP_SOURCE_ACCESS_KEY_ID=
# STORAGE_BACKUP_SOURCE_SECRET_ACCESS_KEY=
# Optional: direct Postgres connections (ORMs, psql) through PgBouncer. Start the stack with
# --profile direct-connections. DATABASE_PUBLIC_HOST must be a DNS-only record (Cloudflare does
# not proxy this port). POOLER_AUTH_PASSWORD: openssl rand -hex 32.
# DATABASE_PUBLIC_HOST=db.example.com
# DATABASE_PUBLIC_PORT=6543
# DATABASE_PUBLIC_SSL_MODE=require
# POOLER_AUTH_PASSWORD=
# A certificate for DATABASE_PUBLIC_HOST lets clients use sslmode=verify-full; without one
# PgBouncer makes a self-signed certificate (encrypted, not verifiable: sslmode=require).
# PGBOUNCER_TLS_CERT_FILE=
# PGBOUNCER_TLS_KEY_FILE=
# Google or GitHub login on the console: configure the provider on the platform tenant, then
# list it here (google,github) and rebuild the caddy service.
CONSOLE_OAUTH_PROVIDERS=
# Support address shown on the console login, MFA and error pages. Required: people locked out
# of their account (lost authenticator, broken link) have no other way to ask for help.
SUPPORT_EMAIL=

# Backups: daily encrypted cluster snapshots to a Cloudflare R2 bucket (create an R2 API token with
# Object Read & Write on that bucket only). Endpoint: https://<account-id>.r2.cloudflarestorage.com
BACKUP_BUCKET=nelcota-backups
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Encrypts the snapshots before upload. Keep a copy outside the VPS: without it, backups cannot be
# restored. openssl rand -hex 32
BACKUP_ENCRYPTION_PASSWORD=
# BACKUP_INTERVAL_SECONDS=86400
# BACKUP_RETENTION_DAYS=30
