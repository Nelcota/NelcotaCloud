{
  "name": "@nelcota/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript client for NelcotaCloud Auth (sessions, OAuth with PKCE, magic links, MFA) and Database.",
  "license": "UNLICENSED",
  "files": [
    "dist",
    "THIRD-PARTY-NOTICES.txt"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:package": "node scripts/check-package.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "api:types": "npx --yes -p typescript@5.9.3 -p openapi-typescript@7.13.0 openapi-typescript ../../crates/server/openapi.json -o src/generated/api-schema.d.ts"
  },
  "devDependencies": {
    "jose": "6.2.18",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "standardwebhooks": "1.3.0",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "packageManager": "npm@12.2.3"
}
