{
	email {$ACME_EMAIL}
}

# The API: tenant apps call it from any origin. Caddy terminates TLS and sets
# X-Forwarded-For, which the API reads as CLIENT_IP_HEADER for rate limits.
{$API_DOMAIN} {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	reverse_proxy api:8080
}

# The console: a single-page app, so unknown paths fall back to index.html.
{$CONSOLE_DOMAIN} {
	encode zstd gzip
	root * /srv/console

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	handle /assets/* {
		# Only existing, fingerprinted assets get the long cache lifetime.
		header {
			Cache-Control "public, max-age=31536000, immutable"
			match status 2xx 304
		}
		file_server
	}

	handle {
		# A direct visit to a nested console route must revalidate the HTML too.
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	handle_errors {
		header Cache-Control "no-store"
		respond "{err.status_text}" {err.status_code}
	}
}
